{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "lib": [
      "ES2023",
      "DOM",
      "DOM.Iterable"
    ],
    "types": [
      "node"
    ]
  },
  "include": [
    "electron",
    "src/shared",
    "src/lib",
    "src/env.d.ts",
    "src/preload/api-types.ts",
    "electron.vite.config.ts",
